# Salin ke .env bila Anda mengaktifkan jalur live. Jangan taruh file ini di git.
# Mode bawaan adalah paper dan tidak membaca kunci apa pun.

# Wajib bernilai persis I_UNDERSTAND sebelum desk live-execute mau berjalan.
PAIRED_DESK_LIVE=

# pumpfun-bonkfun-bot. Bot membaca variabel ini dari env_file-nya, bukan dari argv.
SOLANA_NODE_RPC_ENDPOINT=
SOLANA_NODE_WSS_ENDPOINT=
SOLANA_PRIVATE_KEY=

# Hummingbot. Kata sandi keystore tidak boleh diletakkan di argv.
HBOT_PASSWORD=

# AI Hedge Fund dan Vibe-Trading, hanya jika engines.* = "delegate".
FINANCIAL_DATASETS_API_KEY=
XAI_API_KEY=
